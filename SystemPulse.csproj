<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SystemPulse</RootNamespace>
    <AssemblyName>SystemPulse</AssemblyName>
    <Version>2.3.0</Version>
    <Deterministic>true</Deterministic>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Management" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ui\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="ui" />
    <Content Include="vendor\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="vendor" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Test'">
    <DefineConstants>$(DefineConstants);TESTHOOKS</DefineConstants>
  </PropertyGroup>

</Project>
